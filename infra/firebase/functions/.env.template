# Firebase Functions 환경 변수 템플릿
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# Gemini API Key (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Notion API Key - FAQ 데이터베이스 전용 (Read-only 권한 권장)
NOTION_FAQ_API_KEY=YOUR_NOTION_FAQ_API_KEY_HERE

# Kakao REST API Key (장소 검색)
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY_HERE
