rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users - 하위 컬렉션 있음 (auth, settings, cache)
    match /users/{userId} {
      // 본인 문서만 읽기/쓰기 허용
      // 닉네임 중복 검사 등은 Cloud Function을 통해 구현 권장
      //
      // ⚠️ 보안 정책:
      // - groups[groupId].hasNewActivity: Cloud Functions 전용 필드
      // - 클라이언트는 clearGroupBadge API를 통해서만 변경 가능
      // - 관련 함수: promiseBadges.ts (onPromiseCreatedBadges, clearGroupBadge)
      //
      // 참고: Firestore rules에서 동적 키의 중첩 필드 검증은 제한적이므로
      // 클라이언트 측에서 해당 필드 직접 수정을 금지하고 API 사용을 강제함
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
                          && request.auth.uid == userId;
      }
    }

    // Groups - 하위 컬렉션 없음
    match /groups/{groupId} {
      // 멤버만 읽기 가능 (memberIds 배열에 포함된 경우)
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.memberIds;

      // 그룹 생성은 인증된 사용자만 가능
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.memberIds;

      // 관리자만 수정 가능 (users/{userId}.groups[groupId].role이 admin인 경우)
      allow update, delete: if request.auth != null &&
                               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groups[groupId].role == "admin";
    }

    // Promises - 하위 컬렉션 없음
    match /promises/{promiseId} {
      // 그룹 멤버만 읽기 가능 (groups/{groupId}.memberIds 배열에 포함된 경우)
      allow read: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds;

      // 그룹 멤버만 약속 생성 가능
      allow create: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds;

      // 호스트 또는 그룹 관리자만 수정/삭제 가능
      allow update, delete: if request.auth != null && (
        // 호스트인 경우
        resource.data.hostId == request.auth.uid ||
        // 또는 그룹 관리자인 경우
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groups[resource.data.groupId].role == "admin"
      );

      // votes 필드 업데이트는 그룹 멤버만 가능
      allow update: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'updatedAt']);
    }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
