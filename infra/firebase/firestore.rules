rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{env}/root {

      // Users - 하위 컬렉션 있음 (auth, settings)
      match /users/{userId} {
        // 본인 문서만 읽기/쓰기 허용
        // 닉네임 중복 검사 등은 Cloud Function을 통해 구현 권장
        //
        // ⚠️ 주의: groups[groupId].needResponseCount는 Cloud Functions에서만 관리
        // 클라이언트에서 직접 수정하면 안 됨 (배지 정합성 유지)
        // 관련 함수: promiseBadges.ts의 트리거들
        allow read, write: if request.auth != null
                          && request.auth.uid == userId;

        match /{subcollection}/{docId} {
          allow read, write: if request.auth != null
                            && request.auth.uid == userId;
        }
      }

      // Groups - 하위 컬렉션 없음
      match /groups/{groupId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // Promises - 하위 컬렉션 없음
      match /promises/{promiseId} {
        allow read, write: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
