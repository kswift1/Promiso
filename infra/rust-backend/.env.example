# Direct connection — 마이그레이션 전용 (sqlx migrate)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Pooled connection — 런타임 서버용 (PgBouncer)
DATABASE_POOL_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

PORT=8080
FIREBASE_PROJECT_ID=promiso-dev
RUST_LOG=info
