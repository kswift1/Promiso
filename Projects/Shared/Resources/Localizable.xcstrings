    "home.briefing.reportMail.body": {
      "comment": "브리핑 오류 제보 메일 본문",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for reporting this issue. It helps us improve the briefing experience.\n\nIf there is any additional detail, please write it above.\n\n--- Auto-collected info ---\nUID: %1$@\nGenerated at: %2$@\nSummary: %3$@\nDetail: %4$@\nNotification enabled: %5$@\nLocation enabled: %6$@\nTimezone: %7$@\nLocale: %8$@\n-------------------------\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제보해 주셔서 감사합니다. 더 나은 브리핑을 만드는 데 큰 도움이 됩니다 🙏\n\n상세 내용이 있다면 위에 입력해 주세요.\n\n── 자동 수집 정보 (확인용) ──\nUID: %1$@\n생성 시각: %2$@\n요약: %3$@\n상세: %4$@\n알림 권한: %5$@\n위치 권한: %6$@\nTimezone: %7$@\nLocale: %8$@\n────────────────────\n"
          }
        }
      }
    },
    "home.briefing.reportMail.subject": {
