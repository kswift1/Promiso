        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 계속 사용하려면 최신 버전으로 업데이트해주세요.\n\n현재 버전: %1$@\n필요 버전: %2$@"
          }
        }
      }
    },
