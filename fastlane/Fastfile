# Fastfile
# Promiso iOS Deployment

default_platform(:ios)

platform :ios do
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  # 설정
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  before_all do
    ensure_git_status_clean unless ENV["CI"]

    # CI 환경에서 App Store Connect API Key 설정
    if ENV["CI"] && ENV["APP_STORE_CONNECT_API_KEY_ID"]
      @api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
        key_filepath: "#{Dir.home}/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8"
      )
    end
  end

  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  # Dev 환경 (PromisoDev)
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  desc "Build and upload PromisoDev to TestFlight"
  lane :beta_dev do
    setup_ci if ENV["CI"]

    dev_bundle_ids = [
      "com.promiso.dev",
      "com.promiso.dev.liveactivity",
      "com.promiso.dev.promisewidget"
    ]

    # 1-1. Development 프로파일 (Debug configuration 검증용)
    match(
      type: "development",
      app_identifier: dev_bundle_ids,
      readonly: is_ci,
      api_key: @api_key
    )

    # 1-2. AppStore 프로파일 (Release 빌드용)
    match(
      type: "appstore",
      app_identifier: dev_bundle_ids,
      readonly: is_ci,
      api_key: @api_key
    )

    # 2. 빌드 및 아카이빙 (빌드 번호는 Tuist에서 자동 생성)
    build_app(
      workspace: "Promiso.xcworkspace",
      scheme: "PromisoDev",
      configuration: "Release",
      export_method: "app-store"
    )

    # 4. TestFlight 업로드
    changelog_text = ENV["CHANGELOG"] || "Dev 빌드"
    UI.message("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    UI.message("📝 CHANGELOG 환경변수:")
    UI.message(changelog_text)
    UI.message("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    upload_to_testflight(
      app_identifier: "com.promiso.dev",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: changelog_text,
      localized_build_info: {
        "ko" => {
          whats_new: changelog_text
        }
      }
    )

    # 5. Slack 알림
    if ENV["SLACK_WEBHOOK_URL_DEPLOY"]
      slack(
        message: "✅ [DEV] PromisoDev 빌드 완료",
        success: true,
        slack_url: ENV["SLACK_WEBHOOK_URL_DEPLOY"],
        default_payloads: [:git_branch, :git_author],
        payload: {
          "Environment" => "Development"
        }
      )
    end
  end

  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  # Stage 환경 (PromisoStage)
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  desc "Build and upload PromisoStage to TestFlight"
  lane :beta_stage do
    setup_ci if ENV["CI"]

    stage_bundle_ids = [
      "com.promiso.stage",
      "com.promiso.stage.liveactivity",
      "com.promiso.stage.promisewidget"
    ]

    # 1-1. Development 프로파일 (Debug configuration 검증용)
    match(
      type: "development",
      app_identifier: stage_bundle_ids,
      readonly: is_ci,
      api_key: @api_key
    )

    # 1-2. AppStore 프로파일 (Release 빌드용)
    match(
      type: "appstore",
      app_identifier: stage_bundle_ids,
      readonly: is_ci,
      api_key: @api_key
    )

    # 2. 빌드 및 아카이빙 (빌드 번호는 Tuist에서 자동 생성)
    build_app(
      workspace: "Promiso.xcworkspace",
      scheme: "PromisoStage",
      configuration: "Release",
      export_method: "app-store"
    )

    # 4. TestFlight 업로드
    changelog_text = ENV["CHANGELOG"] || "Stage 테스트 빌드"
    UI.message("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    UI.message("📝 CHANGELOG 환경변수:")
    UI.message(changelog_text)
    UI.message("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    upload_to_testflight(
      app_identifier: "com.promiso.stage",
      skip_waiting_for_build_processing: true,
      distribute_external: true,
      groups: ["Stage Testers"],
      notify_external_testers: true,
      changelog: changelog_text,
      localized_build_info: {
        "ko" => {
          whats_new: changelog_text
        }
      }
    )

    # 5. Slack 알림
    if ENV["SLACK_WEBHOOK_URL_DEPLOY"]
      slack(
        message: "🟡 [STAGE] PromisoStage 빌드 완료 (QA 시작 가능)",
        success: true,
        slack_url: ENV["SLACK_WEBHOOK_URL_DEPLOY"],
        default_payloads: [:git_branch, :git_author],
        payload: {
          "Environment" => "Stage"
        }
      )
    end
  end

  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  # Production 환경 (Promiso)
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  desc "Build and upload Promiso to TestFlight (Production)"
  lane :beta_prod do
    setup_ci if ENV["CI"]

    prod_bundle_ids = [
      "com.promiso",
      "com.promiso.liveactivity",
      "com.promiso.promisewidget"
    ]

    # 1-1. Development 프로파일 (Debug configuration 검증용)
    match(
      type: "development",
      app_identifier: prod_bundle_ids,
      readonly: is_ci,
      api_key: @api_key
    )

    # 1-2. AppStore 프로파일 (Release 빌드용)
    match(
      type: "appstore",
      app_identifier: prod_bundle_ids,
      readonly: is_ci,
      api_key: @api_key
    )

    # 2. 빌드 및 아카이빙 (빌드 번호는 Tuist에서 자동 생성)
    build_app(
      workspace: "Promiso.xcworkspace",
      scheme: "Promiso",
      configuration: "Release",
      export_method: "app-store"
    )

    # 4. TestFlight 업로드
    changelog_text = ENV["CHANGELOG"] || "프로덕션 빌드"
    UI.message("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    UI.message("📝 CHANGELOG 환경변수:")
    UI.message(changelog_text)
    UI.message("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    upload_to_testflight(
      app_identifier: "com.promiso",
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      groups: ["Production Testers"],
      notify_external_testers: true,
      changelog: changelog_text,
      localized_build_info: {
        "ko" => {
          whats_new: changelog_text
        }
      }
    )

    # 5. Slack 알림
    if ENV["SLACK_WEBHOOK_URL_DEPLOY"]
      slack(
        message: "🚀 [PROD] Promiso 빌드 완료 - App Store 제출 준비 완료",
        success: true,
        slack_url: ENV["SLACK_WEBHOOK_URL_DEPLOY"],
        default_payloads: [:git_branch, :git_author, :last_git_commit],
        payload: {
          "Environment" => "Production"
        }
      )
    end
  end

  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  # App Store 배포 (수동)
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  desc "Submit Promiso to App Store Review"
  lane :release do
    # TestFlight에서 최신 빌드를 App Store로 제출
    deliver(
      app_identifier: "com.promiso",
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )

    if ENV["SLACK_WEBHOOK_URL_DEPLOY"]
      slack(
        message: "📱 [PROD] Promiso가 App Store 심사에 제출되었습니다",
        success: true,
        slack_url: ENV["SLACK_WEBHOOK_URL_DEPLOY"],
        payload: {
          "Environment" => "Production"
        }
      )
    end
  end

  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  # 테스트
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  desc "Run tests"
  lane :test do
    run_tests(
      workspace: "Promiso.xcworkspace",
      scheme: "PromisoDev",
      devices: ["iPhone 16"],
      clean: true
    )
  end

  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  # 인증서 관리
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  desc "Setup Match - Initialize certificates for all environments"
  lane :setup_match do
    # API Key 설정 (환경변수 또는 로컬 경로)
    api_key = nil
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
      )
    end

    # 모든 Bundle ID (앱 + Widget Extensions)
    all_bundle_ids = [
      "com.promiso.dev",
      "com.promiso.dev.liveactivity",
      "com.promiso.dev.promisewidget",
      "com.promiso.stage",
      "com.promiso.stage.liveactivity",
      "com.promiso.stage.promisewidget",
      "com.promiso",
      "com.promiso.liveactivity",
      "com.promiso.promisewidget"
    ]

    # Development certificates
    match(
      type: "development",
      app_identifier: all_bundle_ids,
      readonly: false,
      api_key: api_key
    )

    # AppStore certificates
    match(
      type: "appstore",
      app_identifier: all_bundle_ids,
      readonly: false,
      api_key: api_key
    )

    UI.success("✅ Match setup complete for all environments")
  end

  desc "Sync code signing certificates and provisioning profiles"
  lane :sync_certificates do
    # API Key 설정
    api_key = nil
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
      )
    end

    # 모든 Bundle ID (앱 + Widget Extensions)
    all_bundle_ids = [
      "com.promiso.dev",
      "com.promiso.dev.liveactivity",
      "com.promiso.dev.promisewidget",
      "com.promiso.stage",
      "com.promiso.stage.liveactivity",
      "com.promiso.stage.promisewidget",
      "com.promiso",
      "com.promiso.liveactivity",
      "com.promiso.promisewidget"
    ]

    # Development profiles (Debug configuration 검증용)
    match(
      type: "development",
      app_identifier: all_bundle_ids,
      readonly: false,
      api_key: api_key
    )

    # AppStore profiles (Release 빌드용)
    match(
      type: "appstore",
      app_identifier: all_bundle_ids,
      readonly: false,
      api_key: api_key
    )
  end

  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  # 에러 핸들링
  # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  error do |lane, exception|
    if ENV["SLACK_WEBHOOK_URL_DEPLOY"]
      slack(
        message: "❌ #{lane} 실패: #{exception.message}",
        success: false,
        slack_url: ENV["SLACK_WEBHOOK_URL_DEPLOY"],
        default_payloads: [:git_branch, :git_author]
      )
    end
  end
end
