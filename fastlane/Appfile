# Appfile
# 앱 기본 정보

# Apple ID (App Store Connect)
apple_id("your-apple-id@example.com") # ← 실제 Apple ID로 변경

# Team ID (Apple Developer Portal)
team_id("YOUR_TEAM_ID") # ← 실제 Team ID로 변경

# iTunes Connect Team ID (App Store Connect Team ID)
itc_team_id("YOUR_ITC_TEAM_ID") # ← App Store Connect Team ID로 변경 (선택)

