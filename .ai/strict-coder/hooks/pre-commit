#!/usr/bin/env bash
set -euo pipefail

# Layer 3: Git Pre-commit Hook
# infra/rust-backend/src/ 변경이 포함된 커밋에서
# Red→Green 사이클이 완료되었는지 확인한다.

# 커밋에 rust-backend/src/ 변경이 있는지 확인
RUST_SRC_CHANGES=$(git diff --cached --name-only | grep "infra/rust-backend/src/" || true)

# Rust 백엔드 src 변경이 없으면 통과
if [ -z "$RUST_SRC_CHANGES" ]; then
    exit 0
fi

# 테스트 파일만 변경된 경우 통과
NON_TEST_CHANGES=$(echo "$RUST_SRC_CHANGES" | grep -v "_test\.rs$" | grep -v "/tests/" || true)
if [ -z "$NON_TEST_CHANGES" ]; then
    exit 0
fi

# .tdd-state 확인
STATE_FILE="$(git rev-parse --show-toplevel)/.tdd-state"

# .tdd-state가 있고 green이면 통과
if [ -f "$STATE_FILE" ]; then
    GREEN_COMPLETE=$(jq -r '.green_complete // false' "$STATE_FILE")
    if [ "$GREEN_COMPLETE" = "true" ]; then
        exit 0
    fi
fi

# .tdd-state가 없거나 green이 아닌 경우:
# cargo check로 컴파일 검증 (테스트 DB 없이도 동작)
RUST_DIR="$(git rev-parse --show-toplevel)/infra/rust-backend"
echo "TDD 게이트: .tdd-state 없음 — cargo check로 검증 중..." >&2
if ! cargo check --manifest-path "$RUST_DIR/Cargo.toml" 2>&1; then
    echo "" >&2
    echo "TDD 커밋 게이트: 차단" >&2
    echo "  변경 파일:" >&2
    echo "$NON_TEST_CHANGES" | sed 's/^/    /' >&2
    echo "  사유: cargo check 실패. 컴파일 에러를 수정하세요." >&2
    echo "" >&2
    exit 1
fi

# 통과
exit 0
