#!/bin/bash

# Promiso Git Pre-commit Hook
# 민감한 파일 및 API Keys 커밋 방지

echo "🔍 Checking for sensitive files..."

# 1. 민감한 파일 체크 (.xcconfig, GoogleService-Info.plist, .env)
sensitive_files=$(git diff --cached --name-only | grep -E "(\.xcconfig$|GoogleService.*\.plist$|\.env$)" | grep -v "template" || true)

if [ -n "$sensitive_files" ]; then
  echo ""
  echo "❌ Error: Sensitive files detected!"
  echo ""
  echo "Files:"
  echo "$sensitive_files" | sed 's/^/  - /'
  echo ""
  echo "These files should not be committed."
  echo "They are listed in .gitignore and contain API keys."
  exit 1
fi

# 2. API Key 패턴 체크 (코드에 하드코딩된 키)
api_key_patterns="AIza|sk-|xoxb-|ntn_|Bearer [A-Za-z0-9]"
# Hook 스크립트 자체와 template 파일은 제외
api_keys=$(git diff --cached --name-only | grep -v "scripts/hooks/pre-commit" | grep -v "template" | xargs -I {} git diff --cached {} | grep -E "$api_key_patterns" || true)

if [ -n "$api_keys" ]; then
  echo ""
  echo "❌ Error: API Keys detected in code!"
  echo ""
  echo "Found patterns:"
  echo "$api_keys" | head -5
  echo ""
  echo "Remove API keys from code and use environment variables instead."
  exit 1
fi

# 3. Derived 폴더 체크 (Tuist 자동 생성 파일)
derived_files=$(git diff --cached --name-only | grep "Derived/" || true)

if [ -n "$derived_files" ]; then
  echo ""
  echo "⚠️  Warning: Derived files detected!"
  echo ""
  echo "Files:"
  echo "$derived_files" | sed 's/^/  - /'
  echo ""
  echo "Derived files are auto-generated by Tuist."
  echo "They should not be committed."
  echo ""
  read -p "Continue anyway? (y/N): " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
  fi
fi

echo "✅ No sensitive files found"
echo ""
