#!/bin/bash

# ============================================================================
# Promiso Git Pre-push Hook
# ============================================================================
#
# 변경된 모듈의 빌드 (+ 선택적 테스트)를 실행합니다.
# 실패 시 push가 차단됩니다.
#
# 환경변수:
#   PROMISO_CHECK_MODE=build   빌드만 검증 (기본값)
#   PROMISO_CHECK_MODE=test    빌드 + 테스트 검증
#
# 우회: git push --no-verify
#
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# hooks/ → .git/hooks/ 이므로, 프로젝트 루트는 ../../
# install-git-hooks.sh가 복사하므로 실제 위치는 .git/hooks/pre-push
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

echo ""
echo "🔒 Pre-push: 변경 모듈 검증 중..."
echo "   모드: ${PROMISO_CHECK_MODE:-build} (PROMISO_CHECK_MODE 환경변수로 변경 가능)"
echo ""

# run-changed-tests.sh 실행
if [ -f "$PROJECT_ROOT/scripts/run-changed-tests.sh" ]; then
  exec "$PROJECT_ROOT/scripts/run-changed-tests.sh"
else
  echo "⚠️  scripts/run-changed-tests.sh를 찾을 수 없습니다."
  echo "   검증을 건너뛰고 push를 계속합니다."
  exit 0
fi
