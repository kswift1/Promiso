# Promiso 환경변수 템플릿
# 복사: cp .env.template .env
# 주의: .env 파일은 절대 커밋하지 마세요!

# ========================================
# Dev Environment
# ========================================
GOOGLE_CLIENT_ID_DEV=your-dev-client-id.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID_DEV=com.googleusercontent.apps.your-dev-client-id
KAKAO_NATIVE_APP_KEY_DEV=your-dev-kakao-native-app-key
KAKAO_REST_API_KEY_DEV=your-dev-kakao-rest-api-key

# ========================================
# Stage Environment
# ========================================
GOOGLE_CLIENT_ID_STAGE=your-stage-client-id.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID_STAGE=com.googleusercontent.apps.your-stage-client-id
KAKAO_NATIVE_APP_KEY_STAGE=your-stage-kakao-native-app-key
KAKAO_REST_API_KEY_STAGE=your-stage-kakao-rest-api-key

# ========================================
# Production Environment
# ========================================
GOOGLE_CLIENT_ID_PROD=your-prod-client-id.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID_PROD=com.googleusercontent.apps.your-prod-client-id
KAKAO_NATIVE_APP_KEY_PROD=your-prod-kakao-native-app-key
KAKAO_REST_API_KEY_PROD=your-prod-kakao-rest-api-key
